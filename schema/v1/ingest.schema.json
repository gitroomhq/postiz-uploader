{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gitroomhq/postiz-uploader/schema/v1/ingest.schema.json",
  "title": "IngestJob",
  "description": "Fetch a long source video once and write a faststart MP4 and/or a small speech-grade audio track to presigned URLs.",
  "type": "object",
  "required": [
    "version",
    "type",
    "reference",
    "source"
  ],
  "anyOf": [
    {
      "required": [
        "video"
      ],
      "properties": {
        "video": {
          "type": "object"
        }
      }
    },
    {
      "required": [
        "audio"
      ],
      "properties": {
        "audio": {
          "type": "object"
        }
      }
    },
    {
      "required": [
        "transcript"
      ],
      "properties": {
        "transcript": {
          "type": "object"
        }
      }
    }
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "ingest"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "via": {
          "enum": [
            "direct",
            "ytdlp",
            "oxylabs"
          ],
          "default": "direct",
          "description": "direct: plain GET, host checked against ALLOWED_SOURCE_HOSTS. ytdlp: a video page fetched by this worker, host checked against ALLOWED_INGEST_HOSTS. oxylabs: a YouTube URL fetched by Oxylabs into the worker's bucket; the worker never contacts YouTube."
        },
        "max_height": {
          "type": "integer",
          "minimum": 144,
          "maximum": 4320,
          "default": 1080,
          "description": "ytdlp and oxylabs: never pull a rendition taller than this. oxylabs is further capped by OXYLABS_MAX_HEIGHT (720)."
        },
        "proxy": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?|socks5h?)://",
          "description": "ytdlp only: overrides the worker's INGEST_PROXY. Never logged."
        },
        "start_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "oxylabs only: download this window instead of the whole video. Widened to whole seconds; the result's source.trim says what was fetched."
        },
        "end_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "oxylabs only: required with start_seconds."
        }
      }
    },
    "video": {
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "content_type": {
          "const": "video/mp4",
          "default": "video/mp4"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "audio": {
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "content_type": {
          "const": "audio/ogg",
          "default": "audio/ogg"
        },
        "bitrate_kbps": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128,
          "default": 24
        },
        "sample_rate": {
          "enum": [
            16000,
            24000,
            48000
          ],
          "default": 16000
        },
        "unless_transcript": {
          "type": "boolean",
          "default": false,
          "description": "Skip the audio, and the download behind it, when the transcript output found captions."
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "transcript": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "url"
      ],
      "description": "oxylabs only: YouTube's own captions as JSON {version, language, origin, word_level, segments[{start,end,text}], words[{text,start,end}]}. words is filled only for tracks that time every word (auto-generated).",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "content_type": {
          "const": "application/json",
          "default": "application/json"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 12
          },
          "minItems": 1,
          "maxItems": 4,
          "default": [
            "en"
          ],
          "description": "Tried in order; the first language with captions wins. Each miss costs one request."
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "default": 2147483648
        },
        "max_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 7200
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 10,
          "default": 1200
        }
      }
    }
  }
}
